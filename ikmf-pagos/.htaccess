# IKMF Pagos — Apache (cPanel)

# Forzar HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Pasar el header Authorization a PHP (algunos hostings lo descartan)
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# No servir archivos internos del proyecto
RewriteRule ^(supabase|\.git)(/|$) - [F,L]
<FilesMatch "(\.(md|sql|example\.php|sh)|^config\.php)$">
  Require all denied
</FilesMatch>

Options -Indexes

# Que el navegador (sobre todo en celulares) siempre revalide HTML/JS/CSS:
# así cada actualización del sitio se ve sin tener que borrar la caché.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>
